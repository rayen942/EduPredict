# EduPredict — variables d'environnement (exemple)
# Copiez ce fichier en « .env » et renseignez vos vraies valeurs.
# NE COMMITTEZ JAMAIS le fichier .env (il est ignoré par git).

# ── Base de données PostgreSQL ────────────────────────────────────────────────
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=prédection CTNE

# ── Réseau (local uniquement par défaut) ──────────────────────────────────────
HOST=127.0.0.1
PORT=5000
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ── Chatbot Anthropic (optionnel — /chat bascule en moteur local sans clé) ────
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-haiku-4-5
